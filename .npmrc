# Supply-chain hardening.
#
# Only install package versions that have been on the registry for at least
# 7 days. Malicious releases from a compromised maintainer account are almost
# always yanked well inside that window, so the quarantine keeps them out of
# our tree. Requires npm >= 11.6.
min-release-age=7

# Never run a dependency's install/postinstall scripts. This is the primary
# execution vector for the recent registry worms: the payload runs the moment
# the package is unpacked, before any of our code is even imported.
# Nothing in this dependency tree needs a build step at install time.
ignore-scripts=true

# Fail an install outright when a dependency has a known high-severity
# advisory, instead of only printing a summary.
audit-level=high
